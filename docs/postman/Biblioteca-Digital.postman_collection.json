{
  "info": {
    "name": "Biblioteca Digital",
    "description": "Peticiones de la API de mi proyecto final (Biblioteca Digital). Al hacer login o registro el token se guarda solo en la variable {{token}}, para no andar copiándolo a cada rato.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "bookId", "value": "" },
    { "key": "loanId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('token', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo@biblioteca.com\",\n  \"password\": \"Nuevo123\",\n  \"fullName\": \"Usuario Nuevo\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (admin del seed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('token', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@biblioteca.com\",\n  \"password\": \"Admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Check status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/check-status", "host": ["{{baseUrl}}"], "path": ["auth", "check-status"] }
          }
        }
      ]
    },
    {
      "name": "Categorías",
      "item": [
        {
          "name": "Crear categoría (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.id) pm.collectionVariables.set('categoryId', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Poesía\",\n  \"description\": \"Colecciones de poemas\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        },
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["categories"],
              "query": [{ "key": "limit", "value": "10" }, { "key": "offset", "value": "0" }]
            }
          }
        },
        {
          "name": "Editar categoría (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Descripción actualizada\"\n}" },
            "url": { "raw": "{{baseUrl}}/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["categories", "{{categoryId}}"] }
          }
        },
        {
          "name": "Borrar categoría (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["categories", "{{categoryId}}"] }
          }
        }
      ]
    },
    {
      "name": "Libros",
      "item": [
        {
          "name": "Crear libro (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.id) pm.collectionVariables.set('bookId', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Rayuela\",\n  \"author\": \"Julio Cortázar\",\n  \"isbn\": \"978-84-376-0999-7\",\n  \"stock\": 2,\n  \"categoryId\": \"{{categoryId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/books", "host": ["{{baseUrl}}"], "path": ["books"] }
          }
        },
        {
          "name": "Listar libros",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [{ "key": "limit", "value": "10" }, { "key": "offset", "value": "0" }]
            }
          }
        },
        {
          "name": "Editar libro (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stock\": 5\n}" },
            "url": { "raw": "{{baseUrl}}/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["books", "{{bookId}}"] }
          }
        },
        {
          "name": "Borrar libro (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["books", "{{bookId}}"] }
          }
        }
      ]
    },
    {
      "name": "Préstamos",
      "item": [
        {
          "name": "Pedir prestado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.id) pm.collectionVariables.set('loanId', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"bookId\": \"{{bookId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/loans", "host": ["{{baseUrl}}"], "path": ["loans"] }
          }
        },
        {
          "name": "Mis préstamos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/loans/mine?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "mine"],
              "query": [{ "key": "limit", "value": "10" }, { "key": "offset", "value": "0" }]
            }
          }
        },
        {
          "name": "Todos los préstamos (admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/loans?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["loans"],
              "query": [{ "key": "limit", "value": "10" }, { "key": "offset", "value": "0" }]
            }
          }
        },
        {
          "name": "Marcar como devuelto (admin)",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/loans/{{loanId}}/return", "host": ["{{baseUrl}}"], "path": ["loans", "{{loanId}}", "return"] }
          }
        }
      ]
    },
    {
      "name": "Seed",
      "item": [
        {
          "name": "Llenar base de datos con ejemplos",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/seed", "host": ["{{baseUrl}}"], "path": ["seed"] }
          }
        }
      ]
    }
  ]
}
